{
  "name": "@forsy/biosecurity-agent",
  "version": "0.1.2",
  "private": false,
  "type": "module",
  "description": "A local-first, target-centred biosecurity intelligence agent.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "biosecurity-agent": "apps/cli/dist/index.js"
  },
  "files": [
    "apps/cli/dist/**",
    "apps/server/dist/**",
    "apps/viewer/dist/**",
    "assets/bioworld.png",
    "assets/terminal-replay.log",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "concurrently -k -n runtime,viewer -c blue,green \"pnpm dev:server\" \"pnpm dev:viewer\"",
    "dev:server": "tsx watch apps/server/src/index.ts --no-open",
    "dev:viewer": "vite --config apps/viewer/vite.config.ts --host 127.0.0.1",
    "demo": "tsx apps/cli/src/index.ts --demo",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm build:viewer && pnpm build:server && pnpm build:cli",
    "build:viewer": "vite build --config apps/viewer/vite.config.ts",
    "build:server": "tsup apps/server/src/index.ts --format esm --platform node --target node20 --out-dir apps/server/dist --clean --external better-sqlite3",
    "build:cli": "tsup apps/cli/src/index.ts --format esm --platform node --target node20 --out-dir apps/cli/dist --clean --external better-sqlite3",
    "start": "node apps/cli/dist/index.js",
    "doctor": "tsx apps/cli/src/index.ts doctor",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:schemas": "tsx scripts/generate-schemas.ts",
    "audit:prod": "pnpm audit --prod --audit-level high"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.119.0",
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.1",
    "@fastify/static": "10.1.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@mozilla/readability": "0.6.0",
    "@openai/codex-sdk": "0.149.0",
    "better-sqlite3": "12.11.1",
    "cheerio": "1.1.0",
    "commander": "14.0.0",
    "fast-xml-parser": "5.11.0",
    "fastify": "5.12.1",
    "linkedom": "0.18.12",
    "nanoid": "5.1.16",
    "nodemailer": "9.0.5",
    "open": "10.1.2",
    "pdf-parse": "1.1.1",
    "playwright": "1.62.1",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "9.29.0",
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.15.32",
    "@types/nodemailer": "6.4.17",
    "@types/pdf-parse": "1.1.5",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "@xyflow/react": "12.8.1",
    "concurrently": "9.1.2",
    "eslint": "9.29.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "lucide-react": "0.468.0",
    "maplibre-gl": "5.6.1",
    "prettier": "3.5.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tsup": "8.5.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.34.1",
    "vite": "6.3.5",
    "vitest": "3.2.4",
    "zod-to-json-schema": "3.24.5"
  }
}
