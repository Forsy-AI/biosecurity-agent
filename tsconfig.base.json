{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "useDefineForClassFields": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@biosecurity/contracts": ["packages/contracts/src/index.ts"],
      "@biosecurity/safety": ["packages/safety/src/index.ts"],
      "@biosecurity/agent-adapters": ["packages/agent-adapters/src/index.ts"]
    },
    "types": ["node", "vitest/globals"]
  }
}
